# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: restrict OmniBot to one Discord server
DISCORD_GUILD_ID=

# HTTP server
PORT=3000

# Comma-separated browser origins allowed to connect. Leave blank to allow any origin.
ALLOWED_ORIGINS=

# Optional key required to POST messages through the web API.
# Leave blank for local/private development.
WRITE_API_KEY=
